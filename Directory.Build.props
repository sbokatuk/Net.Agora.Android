<Project>

  <PropertyGroup>
    <!--
      Package version is <native SDK version>.<binding revision>, e.g. 4.6.3.1 — the same scheme
      the sibling Net.Agora.iOS repository uses for its own (CocoaPods) line.

      Video binds io.agora.rtc:full-rtc-basic and Voice binds io.agora.rtc:voice-rtc-basic — the
      same engine built without video, which is the whole point: a voice-only app should not carry
      video codecs it never runs. See src/Agora.Binding.props for why the full-sdk/voice-sdk
      umbrella artifacts are deliberately not used. Agora releases both artifacts from the same
      source drop, so the two pins are expected to move together; they are separate properties
      anyway because nothing guarantees it.

      The fourth component belongs to this repository and increments whenever the binding or
      packaging changes while the native artifact stays put.
    -->
    <AgoraVideoVersion>4.6.3</AgoraVideoVersion>
    <AgoraVideoBindingRevision>3</AgoraVideoBindingRevision>
    <AgoraVoiceVersion>4.6.3</AgoraVoiceVersion>
    <AgoraVoiceBindingRevision>3</AgoraVoiceBindingRevision>
    <!--
      Signaling (RTM) is a different product with its own native version line — 2.2.x, nothing to
      do with the RTC 4.6.x line above. See build/BuildNugets.sh for how releases handle packages
      whose versions do not move together.
    -->
    <AgoraSignalingVersion>2.2.6</AgoraSignalingVersion>
    <AgoraSignalingBindingRevision>1</AgoraSignalingBindingRevision>
    <!--
      Chat is a third product on a third native line — 1.4.x. It is the rebranded Easemob/Hyphenate
      IM SDK, which is why its Java classes carry EM-prefixed names in places and its iOS podspec
      still declares a Hyphenate copyright; the Maven artifact and the package namespace are
      Agora's own.
    -->
    <AgoraChatVersion>1.4.0</AgoraChatVersion>
    <AgoraChatBindingRevision>1</AgoraChatBindingRevision>
    <!--
      IoT is a fourth product on a fourth line — 1.3.x. Android and Linux only; Agora ships no iOS
      SDK for it at all, which is why there is no Net.Agora.IoT.iOS and no cross-platform facade.
      See src/Net.Agora.IoT.Android for what else is unusual about it.
    -->
    <AgoraIoTVersion>1.3.0</AgoraIoTVersion>
    <AgoraIoTBindingRevision>1</AgoraIoTBindingRevision>
    <!--
      Whiteboard and Fastboard are netless's, not Agora's own: Agora acquired the product and
      still documents it, but the source and the releases are netless-io's, published to JitPack
      rather than Maven Central. Two independent lines — Fastboard is a UI layer over Whiteboard
      and versions separately.
    -->
    <AgoraWhiteboardVersion>2.16.123</AgoraWhiteboardVersion>
    <AgoraWhiteboardBindingRevision>1</AgoraWhiteboardBindingRevision>
    <AgoraFastboardVersion>1.8.1</AgoraFastboardVersion>
    <AgoraFastboardBindingRevision>1</AgoraFastboardBindingRevision>
    <!--
      The default for projects that do not pick their own line (tests, and the Video binding
      itself); the Voice .csproj overrides this with its own pair.
    -->
    <VersionPrefix>$(AgoraVideoVersion).$(AgoraVideoBindingRevision)</VersionPrefix>

    <Authors>s.bokatuk</Authors>
    <Company>s.bokatuk</Company>
    <Copyright>Copyright © s.bokatuk</Copyright>
    <PackageProjectUrl>https://github.com/sbokatuk/Net.Agora.Android</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sbokatuk/Net.Agora.Android</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      MIT covers the binding code in this repository. Agora's own SDK is distributed under Agora's
      SDK licence terms (not an OSI-approved licence with its own SPDX identifier), so — unlike
      DatadogNet.Android's "MIT AND Apache-2.0" — no second licence expression is added here;
      nothing is claimed about Agora's own terms.
    -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
