<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Net.Agora.Sample.Android"
             x:Class="Net.Agora.Sample.Android.MainPage"
             Title="Net.Agora">

    <Grid Padding="24" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <Label Grid.Row="0"
               Text="Agora Video for .NET Android"
               FontSize="22"
               FontAttributes="Bold" />

        <Label Grid.Row="1"
               x:Name="StatusLabel"
               FontSize="13"
               TextColor="Gray" />

        <Entry Grid.Row="2"
               x:Name="AppIdEntry"
               Placeholder="Agora App ID" />

        <HorizontalStackLayout Grid.Row="3" Spacing="12">
            <Button x:Name="StartButton"
                    Text="Start preview"
                    Clicked="OnStartPreviewClicked" />
            <Button x:Name="StopButton"
                    Text="Stop"
                    IsEnabled="False"
                    Clicked="OnStopClicked" />
            <Button x:Name="FlipButton"
                    Text="Flip"
                    IsEnabled="False"
                    Clicked="OnFlipClicked" />
            <Button x:Name="SignalingButton"
                    Text="Try Signaling"
                    Clicked="OnSignalingClicked" />
        </HorizontalStackLayout>

        <!-- The SurfaceView Agora renders the local camera into - see AgoraVideoView.cs. -->
        <local:AgoraVideoView Grid.Row="4"
                              x:Name="LocalView" />

        <Label Grid.Row="5"
               x:Name="ActivityLabel"
               FontSize="12"
               TextColor="Gray" />

    </Grid>

</ContentPage>
