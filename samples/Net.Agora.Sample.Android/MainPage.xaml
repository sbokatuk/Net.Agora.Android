<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Net.Agora.Sample.Android"
             x:Class="Net.Agora.Sample.Android.MainPage"
             Title="Net.Agora">

    <Grid Padding="24" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <Label Grid.Row="0"
               Text="Agora Video for .NET Android"
               FontSize="22"
               FontAttributes="Bold" />

        <Label Grid.Row="1"
               x:Name="StatusLabel"
               FontSize="13"
               TextColor="Gray" />

        <Entry Grid.Row="2"
               x:Name="AppIdEntry"
               Placeholder="Agora App ID" />

        <!-- Optional (see the class doc): blank, Start preview just stands the engine up. -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Entry x:Name="ChannelEntry" Placeholder="Channel" />
            <Entry x:Name="TokenEntry" Grid.Column="1" Placeholder="Channel token" />
        </Grid>

        <HorizontalStackLayout Grid.Row="4" Spacing="12">
            <Button x:Name="StartButton"
                    Text="Start preview"
                    Clicked="OnStartPreviewClicked" />
            <Button x:Name="StopButton"
                    Text="Stop"
                    IsEnabled="False"
                    Clicked="OnStopClicked" />
            <Button x:Name="FlipButton"
                    Text="Flip"
                    IsEnabled="False"
                    Clicked="OnFlipClicked" />
        </HorizontalStackLayout>

        <!--
          Both views exist for the whole session: creating one on demand would mean creating a
          native SurfaceView mid-layout, which the SDK does not expect — see AgoraVideoView.cs.
        -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="8">
            <local:AgoraVideoView x:Name="LocalView" Grid.Column="0" />
            <local:AgoraVideoView x:Name="RemoteView" Grid.Column="1" />
        </Grid>

        <Label Grid.Row="6"
               x:Name="ActivityLabel"
               FontSize="12"
               TextColor="Gray" />

    </Grid>

</ContentPage>
