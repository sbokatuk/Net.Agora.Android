<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Net.Agora.Sample.Voice.Android.MainPage"
             Title="Net.Agora">

    <Grid Padding="24" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

        <Label Grid.Row="0"
               Text="Agora Voice for .NET Android"
               FontSize="22"
               FontAttributes="Bold" />

        <Label Grid.Row="1"
               x:Name="StatusLabel"
               FontSize="13"
               TextColor="Gray" />

        <Entry Grid.Row="2"
               x:Name="AppIdEntry"
               Placeholder="Agora App ID" />

        <HorizontalStackLayout Grid.Row="3" Spacing="12">
            <Button x:Name="StartButton"
                    Text="Start engine"
                    Clicked="OnStartClicked" />
            <Button x:Name="StopButton"
                    Text="Stop"
                    IsEnabled="False"
                    Clicked="OnStopClicked" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="4" Spacing="24">
            <HorizontalStackLayout Spacing="4">
                <Label Text="Mute" VerticalOptions="Center" />
                <Switch x:Name="MuteSwitch" Toggled="OnMuteToggled" IsEnabled="False" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4">
                <Label Text="Speaker" VerticalOptions="Center" />
                <Switch x:Name="SpeakerSwitch" Toggled="OnSpeakerToggled" IsEnabled="False" />
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <Label Grid.Row="5"
               x:Name="VolumeLabel"
               Text="volume indication off"
               FontAttributes="Italic"
               FontSize="13" />

        <Label Grid.Row="6"
               x:Name="ActivityLabel"
               VerticalOptions="End"
               FontSize="12"
               TextColor="Gray" />

    </Grid>

</ContentPage>
