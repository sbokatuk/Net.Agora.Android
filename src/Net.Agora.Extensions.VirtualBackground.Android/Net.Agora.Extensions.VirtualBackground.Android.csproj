<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AgoraPackageName>Extensions.VirtualBackground</AgoraPackageName>
    <AgoraGroupId>io.agora.rtc</AgoraGroupId>
    <AgoraArtifact>full-virtual-background</AgoraArtifact>
    <!--
      Extensions ride the RTC version line: Agora builds them from the same source drop as
      full-rtc-basic / voice-rtc-basic and publishes them under the same version, so there is no
      separate pin.
    -->
    <AgoraNativeVersion>$(AgoraVideoVersion)</AgoraNativeVersion>
    <!--
      Nothing to bind: full-virtual-background's classes.jar is 22 bytes — an empty archive — and the
      whole .aar is jni/<abi>/*.so. See src/Agora.Extension.md for what that means for this
      package's shape.
    -->
    <AgoraBindArtifact>false</AgoraBindArtifact>
  </PropertyGroup>

  <Import Project="../Agora.Binding.props" />

  <PropertyGroup>
    <Title>The Agora virtual background extension for .NET for Android.</Title>
    <Description>The native payload for Agora's virtual background extension (full-virtual-background $(AgoraVideoVersion) on Maven Central), packaged for .NET for Android. Segments the person from the scene so the background can be blurred, replaced with an image or filled with a colour. Add it alongside Net.Agora.Video.Android or Net.Agora.Voice.Android — it carries no managed API of its own; the switch that turns it on is RtcEngine.EnableVirtualBackground in the RTC binding.</Description>
    <PackageTags>$(PackageTags);RTC;extension;virtual;background</PackageTags>
  </PropertyGroup>

</Project>
