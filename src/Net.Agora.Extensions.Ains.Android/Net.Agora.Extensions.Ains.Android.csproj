<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AgoraPackageName>Extensions.Ains</AgoraPackageName>
    <AgoraGroupId>io.agora.rtc</AgoraGroupId>
    <AgoraArtifact>ains</AgoraArtifact>
    <!--
      Extensions ride the RTC version line: Agora builds them from the same source drop as
      full-rtc-basic / voice-rtc-basic and publishes them under the same version, so there is no
      separate pin.
    -->
    <AgoraNativeVersion>$(AgoraVideoVersion)</AgoraNativeVersion>
    <!--
      Nothing to bind: ains's classes.jar is 22 bytes — an empty archive — and the
      whole .aar is jni/<abi>/*.so. See src/Agora.Extension.md for what that means for this
      package's shape.
    -->
    <AgoraBindArtifact>false</AgoraBindArtifact>
  </PropertyGroup>

  <Import Project="../Agora.Binding.props" />

  <PropertyGroup>
    <Title>The Agora AI noise suppression extension for .NET for Android.</Title>
    <Description>The native payload for Agora's AI noise suppression extension (ains $(AgoraVideoVersion) on Maven Central), packaged for .NET for Android. Removes background noise from the captured microphone stream with a neural model, well beyond what the engine's built-in suppressor manages in a noisy room. Add it alongside Net.Agora.Video.Android or Net.Agora.Voice.Android — it carries no managed API of its own; the switch that turns it on is RtcEngine.SetAINSMode in the RTC binding.</Description>
    <PackageTags>$(PackageTags);RTC;extension;AI;noise;suppression</PackageTags>
  </PropertyGroup>

</Project>
