<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AgoraPackageName>Extensions.Av1Encoder</AgoraPackageName>
    <AgoraGroupId>io.agora.rtc</AgoraGroupId>
    <AgoraArtifact>full-video-av1-codec-enc</AgoraArtifact>
    <!--
      Extensions ride the RTC version line: Agora builds them from the same source drop as
      full-rtc-basic / voice-rtc-basic and publishes them under the same version, so there is no
      separate pin.
    -->
    <AgoraNativeVersion>$(AgoraVideoVersion)</AgoraNativeVersion>
    <!--
      Nothing to bind: full-video-av1-codec-enc's classes.jar is 22 bytes — an empty archive — and the
      whole .aar is jni/<abi>/*.so. See src/Agora.Extension.md for what that means for this
      package's shape.
    -->
    <AgoraBindArtifact>false</AgoraBindArtifact>
  </PropertyGroup>

  <Import Project="../Agora.Binding.props" />

  <PropertyGroup>
    <Title>The Agora AV1 video encoder extension for .NET for Android.</Title>
    <Description>The native payload for Agora's AV1 video encoder extension (full-video-av1-codec-enc $(AgoraVideoVersion) on Maven Central), packaged for .NET for Android. AV1 encoding, for the bandwidth saving over H.264 where both ends support it. Add it alongside Net.Agora.Video.Android or Net.Agora.Voice.Android — it carries no managed API of its own; the switch that turns it on is RtcEngine.SetVideoEncoderConfiguration with an AV1 codec type in the RTC binding.</Description>
    <PackageTags>$(PackageTags);RTC;extension;AV1;video;encoder</PackageTags>
  </PropertyGroup>

</Project>
