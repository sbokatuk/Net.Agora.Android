<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AgoraPackageName>Extensions.ContentInspect</AgoraPackageName>
    <AgoraGroupId>io.agora.rtc</AgoraGroupId>
    <AgoraArtifact>full-content-inspect</AgoraArtifact>
    <!--
      Extensions ride the RTC version line: Agora builds them from the same source drop as
      full-rtc-basic / voice-rtc-basic and publishes them under the same version, so there is no
      separate pin.
    -->
    <AgoraNativeVersion>$(AgoraVideoVersion)</AgoraNativeVersion>
    <!--
      Nothing to bind: full-content-inspect's classes.jar is 22 bytes — an empty archive — and the
      whole .aar is jni/<abi>/*.so. See src/Agora.Extension.md for what that means for this
      package's shape.
    -->
    <AgoraBindArtifact>false</AgoraBindArtifact>
  </PropertyGroup>

  <Import Project="../Agora.Binding.props" />

  <PropertyGroup>
    <Title>The Agora content moderation extension for .NET for Android.</Title>
    <Description>The native payload for Agora's content moderation extension (full-content-inspect $(AgoraVideoVersion) on Maven Central), packaged for .NET for Android. Samples the outgoing video and classifies it on-device, for apps that must moderate what their users broadcast. Add it alongside Net.Agora.Video.Android or Net.Agora.Voice.Android — it carries no managed API of its own; the switch that turns it on is RtcEngine.EnableContentInspect in the RTC binding.</Description>
    <PackageTags>$(PackageTags);RTC;extension;content;moderation</PackageTags>
  </PropertyGroup>

</Project>
