<?xml version="1.0" encoding="utf-8"?>
<metadata>
  <!--
    full-rtc-basic bundles a few internal implementation classes that class-parse cannot bind
    cleanly on its own — custom camera/screen capturers, the raw video-frame/EGL/texture pipeline,
    and the spatial-audio engine's own impl class. None of these are part of the public surface a
    consumer needs to join a channel and publish/subscribe audio and video (RtcEngine itself drives
    the default camera capturer without any of this), so they are removed here rather than patched
    method-by-method. Re-attempt binding them if a later feature needs custom capture or raw frame
    access.
  -->

  <!-- io.agora.rtc2.video: the default camera/screen capturer implementation. -->
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCapture']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureCamera']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureCamera1']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureCamera2']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureScreen']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureCameraFallbackWrapper']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureFactory']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureFormat']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureFormatParser']" />
  <remove-node path="/api/package[@name='io.agora.rtc2.video']/class[@name='VideoCaptureParameter']" />

  <!--
    io.agora.base: VideoFrame's nested TextureBuffer interface declares getType() returning its own
    nested Type enum, which the generator maps to a member named GetType() — colliding with
    object.GetType(). Removing the raw pixel-buffer surface (TextureBuffer/WrappedNativeTextureBuffer
    and VideoFrame itself) rather than renaming, since it is only reachable through the advanced
    IVideoFrameObserver raw-frame path this package does not expose yet.
  -->
  <remove-node path="/api/package[@name='io.agora.base']/class[@name='VideoFrame']" />
  <remove-node path="/api/package[@name='io.agora.base']/class[@name='TextureBuffer']" />
  <remove-node path="/api/package[@name='io.agora.base']/class[@name='WrappedNativeTextureBuffer']" />

  <!-- io.agora.base.internal.video: EGL / hardware-encoder / color-space plumbing behind VideoFrame. -->
  <remove-node path="/api/package[@name='io.agora.base.internal.video']/class[@name='EglBase14']" />
  <remove-node path="/api/package[@name='io.agora.base.internal.video']/class[@name='WrappedNativeColorSpace']" />
  <remove-node path="/api/package[@name='io.agora.base.internal.video']/class[@name='HardwareVideoEncoder']" />

  <!--
    io.agora.spatialaudio.internal: LocalSpatialAudioImpl overrides Release() with a narrower
    access modifier than the interface declares. The interfaces it implements (ILocalSpatialAudioEngine,
    IBaseSpatialAudioEngine) stay bound; only this concrete impl class — never constructed directly
    by a consumer, only handed back through RtcEngine's own factory method — is removed.
  -->
  <remove-node path="/api/package[@name='io.agora.spatialaudio.internal']/class[@name='LocalSpatialAudioImpl']" />
</metadata>
