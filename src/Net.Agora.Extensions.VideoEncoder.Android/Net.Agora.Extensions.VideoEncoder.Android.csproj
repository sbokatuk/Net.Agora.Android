<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AgoraPackageName>Extensions.VideoEncoder</AgoraPackageName>
    <AgoraGroupId>io.agora.rtc</AgoraGroupId>
    <AgoraArtifact>full-video-codec-enc</AgoraArtifact>
    <!--
      Extensions ride the RTC version line: Agora builds them from the same source drop as
      full-rtc-basic / voice-rtc-basic and publishes them under the same version, so there is no
      separate pin.
    -->
    <AgoraNativeVersion>$(AgoraVideoVersion)</AgoraNativeVersion>
    <!--
      Nothing to bind: full-video-codec-enc's classes.jar is 22 bytes — an empty archive — and the
      whole .aar is jni/<abi>/*.so. See src/Agora.Extension.md for what that means for this
      package's shape.
    -->
    <AgoraBindArtifact>false</AgoraBindArtifact>
  </PropertyGroup>

  <Import Project="../Agora.Binding.props" />

  <PropertyGroup>
    <Title>The Agora software video encoder extension for .NET for Android.</Title>
    <Description>The native payload for Agora's software video encoder extension (full-video-codec-enc $(AgoraVideoVersion) on Maven Central), packaged for .NET for Android. The software H.264/H.265 encoder, used when the device's hardware encoder is unavailable or unusable for the requested profile. Add it alongside Net.Agora.Video.Android or Net.Agora.Voice.Android — it carries no managed API of its own; the switch that turns it on is selected by the engine itself once present in the RTC binding.</Description>
    <PackageTags>$(PackageTags);RTC;extension;software;video;encoder</PackageTags>
  </PropertyGroup>

</Project>
