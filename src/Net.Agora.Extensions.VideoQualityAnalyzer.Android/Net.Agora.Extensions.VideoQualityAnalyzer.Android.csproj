<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AgoraPackageName>Extensions.VideoQualityAnalyzer</AgoraPackageName>
    <AgoraGroupId>io.agora.rtc</AgoraGroupId>
    <AgoraArtifact>full-vqa</AgoraArtifact>
    <!--
      Extensions ride the RTC version line: Agora builds them from the same source drop as
      full-rtc-basic / voice-rtc-basic and publishes them under the same version, so there is no
      separate pin.
    -->
    <AgoraNativeVersion>$(AgoraVideoVersion)</AgoraNativeVersion>
    <!--
      Nothing to bind: full-vqa's classes.jar is 22 bytes — an empty archive — and the
      whole .aar is jni/<abi>/*.so. See src/Agora.Extension.md for what that means for this
      package's shape.
    -->
    <AgoraBindArtifact>false</AgoraBindArtifact>
  </PropertyGroup>

  <Import Project="../Agora.Binding.props" />

  <PropertyGroup>
    <Title>The Agora video quality analysis extension for .NET for Android.</Title>
    <Description>The native payload for Agora's video quality analysis extension (full-vqa $(AgoraVideoVersion) on Maven Central), packaged for .NET for Android. Scores the outgoing video's perceptual quality so the engine can trade resolution against frame rate on the evidence rather than on bitrate alone. Add it alongside Net.Agora.Video.Android or Net.Agora.Voice.Android — it carries no managed API of its own; the switch that turns it on is enabled by the engine itself once present in the RTC binding.</Description>
    <PackageTags>$(PackageTags);RTC;extension;video;quality;analysis</PackageTags>
  </PropertyGroup>

</Project>
