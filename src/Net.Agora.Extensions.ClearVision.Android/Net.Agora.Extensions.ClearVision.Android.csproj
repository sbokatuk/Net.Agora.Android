<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AgoraPackageName>Extensions.ClearVision</AgoraPackageName>
    <AgoraGroupId>io.agora.rtc</AgoraGroupId>
    <AgoraArtifact>clear-vision</AgoraArtifact>
    <!--
      Extensions ride the RTC version line: Agora builds them from the same source drop as
      full-rtc-basic / voice-rtc-basic and publishes them under the same version, so there is no
      separate pin.
    -->
    <AgoraNativeVersion>$(AgoraVideoVersion)</AgoraNativeVersion>
    <!--
      Nothing to bind: clear-vision's classes.jar is 22 bytes — an empty archive — and the
      whole .aar is jni/<abi>/*.so. See src/Agora.Extension.md for what that means for this
      package's shape.
    -->
    <AgoraBindArtifact>false</AgoraBindArtifact>
  </PropertyGroup>

  <Import Project="../Agora.Binding.props" />

  <PropertyGroup>
    <Title>The Agora video enhancement extension for .NET for Android.</Title>
    <Description>The native payload for Agora's video enhancement extension (clear-vision $(AgoraVideoVersion) on Maven Central), packaged for .NET for Android. The image-quality filters: low-light enhancement, video denoising, colour enhancement and the face-beautification options. Add it alongside Net.Agora.Video.Android or Net.Agora.Voice.Android — it carries no managed API of its own; the switch that turns it on is RtcEngine.SetLowlightEnhanceOptions / SetVideoDenoiserOptions / SetColorEnhanceOptions / SetBeautyEffectOptions in the RTC binding.</Description>
    <PackageTags>$(PackageTags);RTC;extension;video;enhancement</PackageTags>
  </PropertyGroup>

</Project>
