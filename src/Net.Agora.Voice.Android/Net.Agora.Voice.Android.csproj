<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AgoraPackageName>Voice</AgoraPackageName>
    <!--
      voice-rtc-basic is the same RTC engine as Video's full-rtc-basic, built without the video
      pipeline: the native library drops the video codecs (~28 MB .aar against full's ~48 MB),
      while the Java API layer stays the shared io.agora.rtc2 surface. io.agora.rtc:voice-sdk (the
      POM-only aggregator) is avoided for the same reasons full-sdk is in the Video project — see
      that .csproj.

      This package and Net.Agora.Video.Android are mutually exclusive within one app: both .aars
      carry the same Java classes, so referencing both fails the build at dex merge. That mirrors
      Agora's own artifacts, where an app picks voice-sdk or full-sdk, never both.
    -->
    <AgoraGroupId>io.agora.rtc</AgoraGroupId>
    <AgoraArtifact>voice-rtc-basic</AgoraArtifact>
    <AgoraNativeVersion>$(AgoraVoiceVersion)</AgoraNativeVersion>
    <VersionPrefix>$(AgoraVoiceVersion).$(AgoraVoiceBindingRevision)</VersionPrefix>
    <!--
      This project's own .aar holds nothing but a second copy of the aosl artifact's
      jni/libaosl.so — see AgoraRemoveDuplicateProjectAar in Agora.Binding.props. Dropping it
      from the package is also what clears XA4301 (duplicate libaosl.so) in a consuming app.
    -->
    <AgoraDropProjectAar>true</AgoraDropProjectAar>
  </PropertyGroup>

  <Import Project="../Agora.Binding.props" />

  <!--
    voice-rtc-basic's only dependency, at the version its own POM declares (aosl is versioned
    independently of the RTC SDK — this is not the same as $(AgoraVoiceVersion)). Bind="false":
    nothing here calls into it from C#, it only has to be present at runtime.

    $(AgoraAoslVersion) rather than the literal, because Signaling has to ship this exact same
    aosl — see Directory.Build.props, and Net.Agora.Signaling.Android.csproj for what goes wrong
    when the two differ. One property is what makes "the same" mechanical rather than a promise.
  -->
  <ItemGroup>
    <AgoraMavenArtifact Include="io.agora.infra:aosl" Version="$(AgoraAoslVersion)" Bind="false" />
  </ItemGroup>

  <!--
    Same rename as the Video binding, for the same reason — and deliberately the same resulting
    namespace: Agora's voice artifact is the video engine minus the video pipeline, not a separate
    API, so consumers switching an app between the two packages recompile without touching code.
  -->
  <ItemGroup>
    <AndroidNamespaceReplacement Include="IO.Agora.Rtc2" Replacement="Agora.Rtc" />
  </ItemGroup>

  <!--
    Hand-written C# events over the generated partial RtcEngine. One shared file, mirrored into
    this project AND Net.Agora.Video.Android the same way: both bind the identical io.agora.rtc2
    API layer into the same Agora.Rtc namespace, and the packages are mutually exclusive in one
    app, so the additions must exist identically in each and can never collide.
  -->
  <ItemGroup>
    <Compile Include="../shared/Agora.Rtc.RtcEngineEvents.cs" Link="Additions/RtcEngineEvents.cs" />
  </ItemGroup>

  <PropertyGroup>
    <Description>.NET for Android / .NET MAUI bindings for the Agora Voice Android SDK, generated from io.agora.rtc:voice-rtc-basic $(AgoraVoiceVersion) on Maven Central. Lets a .NET app join Agora RTC channels and publish/subscribe audio, without carrying the video codecs. Use Net.Agora.Video.Android instead if the app ever shows or sends video.</Description>
    <PackageTags>$(PackageTags);Voice;RTC;audio;streaming</PackageTags>
  </PropertyGroup>

</Project>
