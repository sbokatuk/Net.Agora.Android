<!--
  Everything the Android binding projects in this repository have in common.

  Imported explicitly by each .csproj rather than picked up as a Directory.Build.props, because it
  reads properties the project sets (AgoraArtifact, AgoraGroupId, AgoraPackageName,
  AgoraNativeVersion) and Directory.Build.props is imported before the project body, so it would
  see none of them. That leaves each binding project as its identity, its description and its
  extra Maven dependencies.
-->
<Project>

  <PropertyGroup>
    <!--
      Each .NET SDK's Android workload ships reference packs for exactly two target frameworks:
      the .NET 9 band covers net8.0-android + net9.0-android, the .NET 10 band covers
      net9.0-android + net10.0-android. No single SDK can build all three, so
      build/BuildNugets.sh packs twice and merges the results - see build/merge-packages.py.
      AgoraSdkBand selects which pass this build is.

      The API level is pinned per target framework rather than left to the workload's default,
      because it ends up in the lib/<tfm>/ folder name inside the package. A bare
      'net8.0-android' resolves to whatever the installed workload currently defaults to, so a
      workload update would change the packages' advertised target frameworks without a single
      source edit.
    -->
    <AgoraSdkBand Condition=" '$(AgoraSdkBand)' == '' ">net9</AgoraSdkBand>
    <TargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net9' ">net8.0-android34.0;net9.0-android35.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net10' ">net10.0-android36.0</TargetFrameworks>
    <!--
      net8.0-android is past end of support, which the SDK reports as an error. It ships
      deliberately: .NET 8 is still where a large share of MAUI apps are.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>

    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>

    <AssemblyName>Net.Agora.$(AgoraPackageName).Android</AssemblyName>
    <RootNamespace>Net.Agora.$(AgoraPackageName).Android</RootNamespace>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Generated-binding noise: CS1591 (no XML doc comments in the aar), CS0108/CS0114 (Java's
      class hierarchy redeclares members the generator cannot express as overrides), BG8401
      (managed-name collisions fixed case-by-case in Transforms/Metadata.xml), CS0618 (the aar's
      own obsolete-but-still-public members), BG8400/BG8800 (fields and parameters typed with
      classes removed in Transforms/Metadata.xml). BG8605/BG8606 (unresolved Java types) and
      BG8801 (invalid parameter type) are deliberately left visible — they mean something else
      was left out of the binding.

      CS1591 is permanent, not a to-do: Agora's javadoc cannot be imported (no -sources/-javadoc
      classifier exists on Maven Central — verified 404 for full-rtc-basic 4.6.3 and agora-rtm
      2.2.6, and the in-aar agora-rtc-sdk-javadoc.jar contains 0 entries), so IntelliSense is
      hand-written on the Additions surface only.
    -->
    <NoWarn>$(NoWarn);CS1591;CS0108;CS0114;CS0618;BG8401;BG8400;BG8800</NoWarn>
  </PropertyGroup>

  <Target Name="ValidateAgoraSdkBand" BeforeTargets="Build;Pack" Condition=" '$(TargetFrameworks)' == '' ">
    <Error Text="AgoraSdkBand must be 'net9' or 'net10', but was '$(AgoraSdkBand)'." />
  </Target>

  <!--
    The native artifact, resolved straight from Maven Central along with its .pom, via
    AndroidMavenLibrary. Nothing is committed to this repository and there is no fetch script: it
    downloads into ~/.cache/dotnet-android/MavenCacheDirectory, which CI restores from
    actions/cache.

    This also feeds Java dependency verification — the check that fails the build when the .aar
    links against Java types no referenced package provides, turning a runtime
    NoClassDefFoundError into a build error.
  -->
  <PropertyGroup>
    <AgoraBindArtifact Condition=" '$(AgoraBindArtifact)' == '' ">true</AgoraBindArtifact>
    <!-- Where the product's own artifact comes from; see the ItemDefinitionGroup below. -->
    <AgoraMavenRepository Condition=" '$(AgoraMavenRepository)' == '' ">Central</AgoraMavenRepository>

    <!--
      AndroidMavenLibrary arrived in the .NET Android SDK 35. The net8.0-android34.0 reference
      pack has no Xamarin.Android.Bindings.Maven.targets at all, so the item is not merely
      unsupported there — it is unknown, and MSBuild ignores unknown items in silence.

      The failure that causes is the worst kind: the build succeeds, the package is produced, and
      the binding assembly inside it is an empty few-KB shell with no .aar and no types. Nothing
      in the log says so. Caught here by resolving the artifact a second way on net8, and in
      tests/Net.Agora.Android.PackageTests by asserting every binding assembly is large enough to
      contain a real binding.

      net8 therefore gets no Java dependency verification. That is acceptable because net9 and
      net10 bind exactly the same artifact and do verify it, so a missing Java dependency still
      fails the build — just in the other two passes.
    -->
    <AgoraSupportsMavenLibrary>true</AgoraSupportsMavenLibrary>
    <!--
      Compared literally rather than with TargetFramework.StartsWith: during the outer
      cross-targeting build $(TargetFramework) is empty, and a property function on it aborts
      evaluation of this file.
    -->
    <AgoraSupportsMavenLibrary Condition=" '$(TargetFramework)' == 'net8.0-android34.0' ">false</AgoraSupportsMavenLibrary>
  </PropertyGroup>

  <!--
    Defaults for every @(AgoraMavenArtifact), wherever a project declares one.

    Repository takes AndroidMavenLibrary's own values — "Central", "Google", or a repository URL.
    The URL form is what the Whiteboard and Fastboard bindings need: netless publishes to JitPack,
    which builds from a GitHub tag rather than hosting a release, so there is no Maven Central
    coordinate to point at. The net8 fallback target below understands the same three forms.
  -->
  <ItemDefinitionGroup>
    <AgoraMavenArtifact>
      <Repository>Central</Repository>
      <Packaging>aar</Packaging>
      <Bind>false</Bind>
    </AgoraMavenArtifact>
  </ItemDefinitionGroup>

  <ItemGroup>
    <AgoraMavenArtifact Include="$(AgoraGroupId):$(AgoraArtifact)"
                        Version="$(AgoraNativeVersion)"
                        Bind="$(AgoraBindArtifact)"
                        Repository="$(AgoraMavenRepository)"
                        Packaging="aar" />
  </ItemGroup>

  <!--
    Projected in a target, not in an ItemGroup here. This file is imported from the middle of each
    .csproj, and MSBuild evaluates a project top to bottom, so an ItemGroup at this point would see
    only the artifact declared above — silently missing any extra @(AgoraMavenArtifact) rows a
    project adds below its Import (e.g. an extra infra dependency like aosl).

    Running after evaluation means the whole list is present regardless of where a project
    declares its rows.
  -->
  <Target Name="ProjectAgoraMavenArtifacts"
          Condition=" '$(AgoraSupportsMavenLibrary)' == 'true' "
          BeforeTargets="_MavenRestore;_VerifyJavaDependencies;_CategorizeAndroidLibraries">
    <ItemGroup>
      <AndroidMavenLibrary Include="@(AgoraMavenArtifact)" />
    </ItemGroup>
  </Target>

  <!--
    The download path for net8.0-android34.0, where AndroidMavenLibrary does not exist. Both the
    downloads and the @(AndroidLibrary) items live inside the target, and paths are made absolute
    there: $(IntermediateOutputPath) is not final while this file is being evaluated — it is
    imported from the project body, before the .NET SDK's targets have appended the configuration
    and target framework to it — so an item declared at evaluation time would capture a path that
    is not where the file ends up.
  -->
  <Target Name="DownloadAgoraMavenArtifacts"
          Condition=" '$(AgoraSupportsMavenLibrary)' != 'true' "
          BeforeTargets="_MavenRestore;_CategorizeAndroidLibraries">
    <PropertyGroup>
      <_AgoraArtifactDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)'))maven</_AgoraArtifactDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_AgoraResolved Include="@(AgoraMavenArtifact)">
        <Group>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', ':.*$', ''))</Group>
        <ArtifactId>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '^.*:', ''))</ArtifactId>
      </_AgoraResolved>
      <_AgoraResolved>
        <GroupPath>$([System.String]::Copy('%(Group)').Replace('.', '/'))</GroupPath>
        <!--
          The same three forms AndroidMavenLibrary accepts. The URL case is matched first and by
          prefix, so a repository this file has never heard of still resolves: the alternative is
          a silent fall-through to Maven Central and a 404 that reads like a wrong version.
        -->
        <BaseUrl Condition=" $([System.String]::Copy('%(Repository)').StartsWith('http')) ">%(Repository)</BaseUrl>
        <BaseUrl Condition=" '%(Repository)' == 'Google' ">https://dl.google.com/dl/android/maven2</BaseUrl>
        <BaseUrl Condition=" '%(Repository)' == 'Central' ">https://repo1.maven.org/maven2</BaseUrl>
      </_AgoraResolved>
      <_AgoraResolved>
        <MavenFileName>%(ArtifactId)-%(Version).%(Packaging)</MavenFileName>
      </_AgoraResolved>
    </ItemGroup>

    <Error Condition=" '%(_AgoraResolved.BaseUrl)' == '' "
           Text="@(_AgoraResolved) declares Repository='%(_AgoraResolved.Repository)', which is neither 'Central', 'Google', nor a URL." />

    <MakeDir Directories="$(_AgoraArtifactDirectory)" />

    <DownloadFile
        SourceUrl="%(_AgoraResolved.BaseUrl)/%(_AgoraResolved.GroupPath)/%(_AgoraResolved.ArtifactId)/%(_AgoraResolved.Version)/%(_AgoraResolved.MavenFileName)"
        DestinationFolder="$(_AgoraArtifactDirectory)"
        SkipUnchangedFiles="true"
        Retries="3" />

    <ItemGroup>
      <AndroidLibrary Include="$(_AgoraArtifactDirectory)/%(_AgoraResolved.MavenFileName)"
                      Bind="%(_AgoraResolved.Bind)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <TransformFile Include="Transforms/Metadata.xml" Condition="Exists('$(MSBuildProjectDirectory)/Transforms/Metadata.xml')" />
    <TransformFile Include="Transforms/EnumFields.xml" Condition="Exists('$(MSBuildProjectDirectory)/Transforms/EnumFields.xml')" />
    <TransformFile Include="Transforms/EnumMethods.xml" Condition="Exists('$(MSBuildProjectDirectory)/Transforms/EnumMethods.xml')" />
  </ItemGroup>

  <!-- Packaging -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Net.Agora.$(AgoraPackageName).Android</PackageId>
    <Title>.NET for Android bindings for the native Agora $(AgoraArtifact) module.</Title>
    <PackageTags>$(PackageTags);agora;SDK;MAUI;Android;dotnet-android;Binding</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../build/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>

  <!--
    R8/ProGuard keep rules. A project that has a proguard.cfg gets it packed under proguard/ plus
    the shared buildTransitive targets (renamed to <PackageId>.targets so NuGet auto-imports it
    into consumers) that feeds it to the app's R8 run — see Agora.Proguard.targets for why the
    bindings cannot rely on R8's own reachability analysis. Only the aars that ship no (or
    partial) proguard.txt of their own need one: Signaling, Chat, Whiteboard, IoT, Fastboard.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/proguard.cfg')">
    <!--
      PackagePath is a directory on purpose: NuGet only honors a file-renaming PackagePath when
      the source and target extensions match, and silently creates a directory named like the
      file otherwise. The package id is already in the installed path, so the plain name loses
      nothing.
    -->
    <None Include="$(MSBuildProjectDirectory)/proguard.cfg" Pack="true" PackagePath="proguard/" />
    <None Include="$(MSBuildThisFileDirectory)Agora.Proguard.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" Visible="false" />
  </ItemGroup>

  <!--
    Drop the project's own .aar where it only duplicates a payload the package already carries.

    Every non-application project produces one (_CreateAar in
    Microsoft.Android.Sdk.AndroidLibraries.targets), built from the project's resources, assets,
    manifest, embedded jars, native libraries and ProGuard rules, and the SDK packs it into
    lib/<tfm> beside the artifacts. What lands in it here was measured per package rather than
    assumed:

      Signaling, Chat, IoT, Whiteboard, Fastboard  proguard.txt only, a few hundred bytes — the
                                                   keep rules below, delivered the same way
                                                   Agora's own .aars deliver theirs. Worth keeping.
      Video, Voice                                 jni/libaosl.so for four ABIs, lifted out of the
                                                   aosl artifact packed next to it. 2.2 MB of pure
                                                   duplication per target framework, and the
                                                   reason a consuming app warns XA4301 about a
                                                   duplicate libaosl.so.
      The 12 extensions                            the extension's own jni/*.so set, lifted out of
                                                   the artifact packed next to it — up to 12 MB
                                                   doubled in one package.

    So the duplication is exactly the projects whose .aar holds native libraries: those come from
    a companion artifact that ships in the same lib/<tfm> directory, and an app picks that up
    through _ResolveAars, which globs every .aar out of a referenced package. Nothing else in
    these projects contributes to the file. AgoraDropProjectAar defaults to the payload-only
    packages and is set by the two RTC bindings, which are the bound projects carrying a
    non-bound companion.
  -->
  <PropertyGroup>
    <AgoraDropProjectAar Condition=" '$(AgoraDropProjectAar)' == '' And '$(AgoraBindArtifact)' == 'false' ">true</AgoraDropProjectAar>
  </PropertyGroup>

  <Target Name="AgoraRemoveDuplicateProjectAar"
          AfterTargets="_IncludeAarInNuGetPackage"
          Condition=" '$(AgoraDropProjectAar)' == 'true' ">
    <ItemGroup>
      <TfmSpecificPackageFile Remove="$(_AarOutputPath)" />
    </ItemGroup>
  </Target>

  <!--
    Strip specific entries out of a referenced *third-party* .aar before it is packed — for a
    companion artifact that vendors its own stale copy of a native library another artifact in the
    same package also carries at a newer, incompatible version.

    Sibling case to AgoraRemoveDuplicateProjectAar above, one level up: that one drops a project's
    own generated .aar where it only repeats a companion artifact's payload; this one edits a
    *companion* artifact itself, where it duplicates another companion artifact's payload under
    the same jni/<abi>/<name>.so path. Both exist because _ResolveAars globs every .aar out of a
    referenced package indiscriminately — a consuming app has no way to prefer one copy over the
    other, so the wrong one wins exactly as often as the right one does.

    A project sets both properties to use this:

      <AgoraStripAarFileName>agora-rtm-2.2.6.aar</AgoraStripAarFileName>
      <AgoraStripAarEntries>"jni/*/libaosl.so"</AgoraStripAarEntries>

    AgoraStripAarFileName must match one @(None) item's file name exactly — that is where a
    Maven-resolved third-party .aar first becomes pack-bound. _CategorizeAndroidLibraries (in the
    Android workload's Xamarin.Android.AvailableItems.targets) is what converts every @(AndroidLibrary)
    with a .aar extension into a @(None) item carrying TfmSpecificPackageFile="%(AndroidLibrary.Pack)";
    that conversion is unconditional on Bind, so it catches Bind="false" infra payloads (like aosl)
    exactly the same as the library actually being bound (agora-rtm itself). _IncludeAarInNuGetPackage
    only folds @(None) items already tagged TfmSpecificPackageFile="true" into the pack — by then the
    file name has already been decided, so this target has to run at or before that point, hence
    AfterTargets="_CategorizeAndroidLibraries" rather than "_IncludeAarInNuGetPackage": the latter
    only ever sees this project's own generated .aar (Agora.Binding.props's own
    AgoraRemoveDuplicateProjectAar target above), never a third-party Maven one — confirmed by
    dumping @(TfmSpecificPackageFile) at that point and finding Maven aars simply absent from it.
    AgoraStripAarEntries is passed to `zip -d` as-is, so multiple patterns are space-separated
    (each individually quoted, as above) the same way they would be on its own command line.

    ->Distinct() below: on the net8.0-android34.0 (legacy) band specifically, this same target's
    own second None-producing line — <None Include="@(LibraryProjectZip)" Exclude="@(AndroidLibrary)" />
    — fails to exclude a Bind="true" .aar (agora-rtm itself) from @(LibraryProjectZip) even though
    it is also in @(AndroidLibrary), so that file's @(None) item is added twice with otherwise
    identical metadata (confirmed via diagnostic-verbosity build log). Both copies share the same
    Identity, so Distinct() collapses them back to one; net9.0+ does not hit this, since
    Xamarin.Android.AvailableItems.targets dropped that second None line entirely.
  -->
  <Target Name="AgoraStripNativeLibraryEntries"
          AfterTargets="_CategorizeAndroidLibraries"
          Condition=" '$(AgoraStripAarFileName)' != '' ">
    <ItemGroup>
      <_AgoraAarToStripAll Include="@(None)"
                        Condition=" '%(FileName)%(Extension)' == '$(AgoraStripAarFileName)' and '%(None.TfmSpecificPackageFile)' == 'true' " />
      <_AgoraAarToStrip Include="@(_AgoraAarToStripAll->Distinct())" />
    </ItemGroup>

    <!--
      Fails loudly rather than silently packing the untouched (conflicting) original: a version
      bump that changes the Maven file name (e.g. a new AgoraSignalingVersion) would otherwise
      reintroduce the exact bug this target fixes, with nothing in the build log to say so.
    -->
    <Error Condition=" '@(_AgoraAarToStrip)' == '' "
           Text="AgoraStripAarFileName is '$(AgoraStripAarFileName)', which is not among the .aar files this project is packing. Did the Maven artifact or its version change?" />

    <PropertyGroup>
      <_AgoraStrippedAarDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)'))stripped/</_AgoraStrippedAarDirectory>
      <_AgoraStrippedAar>$(_AgoraStrippedAarDirectory)$(AgoraStripAarFileName)</_AgoraStrippedAar>
    </PropertyGroup>

    <MakeDir Directories="$(_AgoraStrippedAarDirectory)" />
    <Copy SourceFiles="@(_AgoraAarToStrip)" DestinationFiles="$(_AgoraStrippedAar)" />

    <!-- zip -d deletes every matching entry from the archive in place. -->
    <Exec Command="zip -d &quot;$(_AgoraStrippedAar)&quot; $(AgoraStripAarEntries)" />

    <ItemGroup>
      <None Remove="@(_AgoraAarToStrip)" />
      <!--
        Same metadata as the item just removed (Link is what _IncludeAarInNuGetPackage's %(Filename)
        keys off, not the Identity path), so the packed layout (lib/<tfm>/<name>.aar) is unchanged —
        only that one file's contents are.
      -->
      <None Include="$(_AgoraStrippedAar)"
            TfmSpecificPackageFile="true"
            Pack="false"
            CopyToOutputDirectory="PreserveNewest"
            Link="%(_AgoraAarToStrip.Filename)%(_AgoraAarToStrip.Extension)" />
    </ItemGroup>
  </Target>

</Project>
